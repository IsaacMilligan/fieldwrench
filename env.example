DATABASE_URL=postgres://USER:PASS@HOST:5432/postgres?sslmode=require
SESSION_SECRET=replace-with-64-hex-chars
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Optional: Vehicle Finder Free VIN decode (NHTSA fallback when unset). No oil lookups.
VEHICLE_FINDER_API_KEY=
# Optional: "Add from O'Reilly screenshot" oil-spec import (vision model, strict JSON, server-side only).
# Without a key the button shows "Screenshot import needs OPENAI_API_KEY set" and manual entry still works.
OPENAI_API_KEY=
# Optional alternative provider (used only when OPENAI_API_KEY is empty, or OIL_VISION_PROVIDER=xai).
XAI_API_KEY=
# Optional overrides: OIL_VISION_PROVIDER=openai|xai ; OIL_VISION_MODEL (default gpt-4.1-mini / grok-4.7)
OIL_VISION_PROVIDER=
OIL_VISION_MODEL=
# Optional: external read-only access to GET /api/oil/specs (e.g. the VIN decoder app, server-side).
# Token auth is OFF unless BOTH are set. The token only ever reads verified specs for this one shop id.
OIL_SPECS_READ_TOKEN=
OIL_SPECS_READ_SHOP_ID=live
# Optional: bot writes to POST /api/oil/specs (saves VERIFIED specs into the live shop).
# Bearer token only (session cookies are not accepted). Unset = every POST gets 401.
OIL_SPEC_BOT_TOKEN=
